{
  "name": "proxy-backend",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "build:ui": "node scripts/copy-ui.cjs",
    "build:backend": "node -e \"const fs=require('fs');try{fs.rmSync('tsconfig.tsbuildinfo')}catch(e){}\" && nest build && node -e \"const fs=require('fs');fs.rmSync('dist/public',{recursive:true,force:true});fs.cpSync('public','dist/public',{recursive:true})\"",
    "build:full": "npm run build:ui && npm run build:backend",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "pack": "npm run build:full && electron-builder --win portable",
    "dist": "npm run build:full && electron-builder --win",
    "electron:dev": "npm run build:full && electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/serve-static": "^4.0.2",
    "@rekog/mcp-nest": "^1.9.10",
    "@types/node": "^25.9.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "lowdb": "^7.0.1",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@types/express": "^5.0.6",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.easy-proxy.app",
    "productName": "Easy Proxy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true
  }
}
